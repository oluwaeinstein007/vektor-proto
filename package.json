{
  "name": "@vektor/proto",
  "version": "0.1.0",
  "description": "Source-of-truth contracts for VEKTOR: Zod schemas (TS) + gRPC .proto (TS<->Python boundary). See README.md.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "import": "./dist/llm.js"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "codegen:ts": "mkdir -p src/generated && protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true -I proto proto/*.proto",
    "codegen:py": "python3 -m grpc_tools.protoc -I proto --python_out=python/vektor_proto --grpc_python_out=python/vektor_proto proto/*.proto && protol --in-place --python-out python/vektor_proto protoc --protoc-path=protoc --proto-path=proto proto/llm.proto",
    "codegen": "pnpm run codegen:ts && pnpm run codegen:py",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@grpc/grpc-js": "^1.14.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "grpc-tools": "^1.12.4",
    "ts-proto": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "grpc-tools",
      "protobufjs"
    ]
  }
}
